PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=medhikaadmin
RAZORPAY_KEY_ID=rzp_test_PASTE_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=PASTE_YOUR_KEY_SECRET_HERE

# JWT Authentication Secret Key (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=paste_a_secure_random_64_char_hex_secret_here

# Allowed CORS Origins (comma-separated, or * in dev)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://salon-application.onrender.com

# Security OTP Email Transporter Configurations (Gmail App Password is recommended)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Optional: Set these if using custom non-Gmail SMTP host
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

